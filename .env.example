# ==========================================
# 1. NETWORK & CHAIN CONFIGURATION
# ==========================================
AEVUM_RPC_URL="https://rpc-test.qday.info"
AEVUM_CHAIN_ID=44005
AEVUM_EXPLORER_URL="https://explorer-test.qday.info"
TUSD8_ADDRESS="0x456569838f1d43009A91ebA4263147Afd7233483"

# ==========================================
# 2. DEPLOYED CONTRACT ADDRESSES
# ==========================================
# Address generated after running DeployAevum.s.sol
NEXUS_ESCROW_ADDRESS=""
NEXT_PUBLIC_NEXUS_ESCROW_ADDRESS=""

# ==========================================
# 3. WALLET KEYS (TESTNET ONLY - NEVER USE MAINNET)
# ==========================================
# Human Principal: Holds tUSD8 and signs EIP-712 session delegation
PRINCIPAL_ADDRESS=""
PRINCIPAL_PRIVATE_KEY=""
# Foundry broadcast key. deploy-aevum uses this, or PRINCIPAL_PRIVATE_KEY when it is empty.
PRIVATE_KEY=""

# Go Orchestrator: Ephemeral key executing scoped on-chain escrow locks
ORCHESTRATOR_AGENT_ADDRESS=""
ORCHESTRATOR_AGENT_PRIVATE_KEY=""

# Rust Worker: Signs compute proofs and claims escrowed payouts
WORKER_ADDRESS=""
WORKER_PRIVATE_KEY=""

# ==========================================
# 4. SERVICE PORTS & COMMUNICATION
# ==========================================
WORKER_PORT=8080
ORCHESTRATOR_PORT=8081
WORKER_URL="http://agent-worker:8080"
NEXT_PUBLIC_ORCHESTRATOR_API_URL="http://localhost:8081"
NEXT_PUBLIC_API_URL="http://localhost:8081"
NEXT_PUBLIC_AEVUM_RPC_URL="https://rpc-test.qday.info"
PER_TASK_LIMIT=1000000
HOURLY_LIMIT=10000000
ALLOWED_ORIGINS="http://localhost:3000"
ENABLE_PUBLIC_SANDBOX=false
SANDBOX_MAX_JOBS_PER_IP_HOUR=5
LLM_API_URL=""
LLM_API_KEY=""
