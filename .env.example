# QDay Aevum Testnet
AEVUM_RPC_URL=https://rpc-test.qday.info
CHAIN_ID=44005
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# Deployer EOA. Fund with tQDAY. Never commit a real key.
DEPLOYER_PRIVATE_KEY=

# Filled in after forge script
ESCROW_ADDRESS=

# Worker compute provider. Fund the address with tQDAY for claim gas.
WORKER_PRIVATE_KEY=
PAYMENT_AMOUNT=250000
TASK_TIMEOUT_BLOCKS=50
WORKER_BIND_ADDR=0.0.0.0:4020

# Orchestrator session key. This address is the agentKey the principal authorizes.
# Fund it with tQDAY for lock gas. tUSD8 is pulled from the principal, not this key.
SESSION_PRIVATE_KEY=
WORKER_URL=http://127.0.0.1:4020
PER_TASK_LIMIT=1000000
HOURLY_LIMIT=10000000
ORCHESTRATOR_BIND_ADDR=0.0.0.0:8080

# Command center
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_ORCHESTRATOR_URL=http://127.0.0.1:8080
NEXT_PUBLIC_AEVUM_RPC_URL=https://rpc-test.qday.info
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
